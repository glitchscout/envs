diff --git a/scenes/game_elements/props/interact_area/interact_area.gd b/scenes/game_elements/props/interact_area/interact_area.gd
index bbc8f4bc..b9403e2a 100644
--- a/scenes/game_elements/props/interact_area/interact_area.gd
+++ b/scenes/game_elements/props/interact_area/interact_area.gd
@@ -55,9 +55,29 @@ var _indicator: Node2D
 
 
 func start_interaction(player: Player, from_right: bool) -> void:
+	_glitchscout_event("interaction_started", {"action": action_text})
 	interaction_started.emit(player, from_right)
 
 
+# Glitchscout QA: game events, through the node so a build without the SDK still runs.
+func _glitchscout_event(event_name: String, data: Dictionary) -> void:
+	var gs := get_node_or_null("/root/Glitchscout")
+	if gs:
+		gs.event(event_name, data)
+
+
+# Glitchscout QA: this area, as an interactable.
+func glitchscout_observe() -> Dictionary:
+	var script: Script = get_parent().get_script()
+	var type := script.get_global_name() if script else &""
+	return {
+		"type": str(type) if type else "interactable",
+		"state": "disabled" if disabled else "available",
+		"enabled": not disabled,
+		"required_action": "interact",
+	}
+
+
 func end_interaction() -> void:
 	interaction_ended.emit()
 
