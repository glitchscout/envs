diff --git a/addons/glitchscout_qa/glitchscout_qa.gd b/addons/glitchscout_qa/glitchscout_qa.gd
new file mode 100644
index 00000000..3ec158eb
--- /dev/null
+++ b/addons/glitchscout_qa/glitchscout_qa.gd
@@ -0,0 +1,44 @@
+# SPDX-License-Identifier: MPL-2.0
+extends Node
+## Glitchscout QA: turns the game's own signals into test events, so the patches to upstream files stay small.
+## Ships in test builds only. Every event goes through the SDK's node, so the game runs the same without it.
+
+var _player: Player
+
+
+func _ready() -> void:
+	DialogueManager.dialogue_started.connect(func(_resource: Variant) -> void: _event("dialogue_started"))
+	DialogueManager.dialogue_ended.connect(func(_resource: Variant) -> void: _event("dialogue_ended"))
+	GameState.player_changed.connect(_on_player_changed)
+	get_tree().scene_changed.connect(_on_scene_changed)
+
+
+func _on_player_changed(_old: PlayerState, _new: PlayerState) -> void:
+	if not GameState.quest:
+		return
+	_event("quest_changed", {"quest": GameState.quest.quest.resource_path})
+	var inventory := GameState.quest.inventory
+	if not inventory.item_collected.is_connected(_on_item_collected):
+		inventory.item_collected.connect(_on_item_collected)
+
+
+func _on_item_collected(item: InventoryItem) -> void:
+	_event("item_collected", {"item": item.type_name()})
+
+
+func _on_scene_changed() -> void:
+	var player := get_tree().get_first_node_in_group("player") as Player
+	if player and player != _player:
+		_player = player
+		player.mode_changed.connect(_on_player_mode_changed)
+
+
+func _on_player_mode_changed(mode: Player.Mode) -> void:
+	if mode == Player.Mode.DEFEATED:
+		_event("player_defeated")
+
+
+func _event(event_name: String, data: Dictionary = {}) -> void:
+	var gs := get_node_or_null("/root/Glitchscout")
+	if gs:
+		gs.event(event_name, data)
