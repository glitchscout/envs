diff --git a/addons/glitchscout_qa/glitchscout_qa.gd b/addons/glitchscout_qa/glitchscout_qa.gd
new file mode 100644
index 0000000..fc6f6b1
--- /dev/null
+++ b/addons/glitchscout_qa/glitchscout_qa.gd
@@ -0,0 +1,43 @@
+# SPDX-License-Identifier: MIT
+extends Node
+## Glitchscout QA: test-only settings and checks for the TPS demo. Ships in test builds only, and does nothing without
+## the SDK's node.
+
+## More nodes than the level ever has, so a runaway spawn shows. Counted rather than timed: a count doesn't depend on how
+## fast the machine renders.
+const TOO_MANY_NODES := 8000
+const CHECK_EVERY_FRAMES := 60
+
+var _frames := 0
+var _warned := false
+
+
+func _ready() -> void:
+	if not get_node_or_null("/root/Glitchscout"):
+		set_process(false)
+		return
+	# A window rather than the exclusive fullscreen the game defaults to, and no vsync: a test sets its own frame rate.
+	Settings.config_file.set_value("video", "display_mode", Window.MODE_WINDOWED)
+	Settings.config_file.set_value("video", "vsync", DisplayServer.VSYNC_DISABLED)
+	# A preset software rendering (Mesa llvmpipe in CI) draws fast enough to step the game: the 3D view at half
+	# resolution, baked lightmaps rather than voxel GI, and none of the screen-space effects, shadows or fog. The level,
+	# its robots and particles are all still drawn.
+	Settings.config_file.set_value("video", "resolution_scale", 0.5)
+	Settings.config_file.set_value("video", "scale_filter", Viewport.SCALING_3D_MODE_BILINEAR)
+	Settings.config_file.set_value("rendering", "shadow_mapping", false)
+	Settings.config_file.set_value("rendering", "gi_type", Settings.GIType.LIGHTMAP_GI)
+	Settings.config_file.set_value("rendering", "gi_quality", Settings.GIQuality.LOW)
+	Settings.config_file.set_value("rendering", "ssao_quality", -1)
+	Settings.config_file.set_value("rendering", "ssil_quality", -1)
+	Settings.config_file.set_value("rendering", "bloom", false)
+	Settings.config_file.set_value("rendering", "volumetric_fog", false)
+
+
+func _process(_delta: float) -> void:
+	_frames += 1
+	if _warned or _frames % CHECK_EVERY_FRAMES != 0:
+		return
+	var count := get_tree().get_node_count()
+	if count > TOO_MANY_NODES:
+		_warned = true
+		get_node("/root/Glitchscout").event("too_many_nodes", {"nodes": count})
